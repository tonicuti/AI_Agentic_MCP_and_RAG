PORT=3000
SERVER=http://localhost

QWEN_MODEL=onnx-community/Qwen3-0.6B-ONNX
QWEN_DTYPE=fp32
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

WEATHER_API_KEY=your_weather_api_key

CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_SSL=false
CHROMA_COLLECTION=rag_documents

VECTOR_DB=chroma
# VECTOR_DB=pgvector

RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=100
RAG_RESET_COLLECTION=true

POSTGRES_URL=postgres://postgres:postgres@localhost:5432/rag_vector_db
PGVECTOR_TABLE=rag_vectors
EMBEDDING_DIMS=384

HF_DATASET=neural-bridge/rag-dataset-1200
HF_DATASET_CONFIG=default
HF_DATASET_TRAIN_SPLIT=train
HF_DATASET_TEST_SPLIT=test
RAG_BENCHMARK_TOP_K=5
